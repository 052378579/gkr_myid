      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  u.status, u.nama_lengkap, u.divisi, \n  u.status_interaksi, u.last_search_ids, \n  TIMESTAMPDIFF(MINUTE, u.sesi_terakhir_update, NOW()) as menit_sesi,\n  '{{ $json.text }}' AS text, \n  '{{ $json.chatId }}' AS chatId, \n  '{{ $json.msg_type }}' AS msg_type, \n  '{{ $json.intent }}' AS intent, \n  '{{ $json.tipe_balasan }}' AS tipe_balasan, \n  '{{ $json.keyword }}' AS keyword,\n  '{{ $json.keyword_2 }}' AS keyword_2,\n  '{{ $json.source }}' AS source\nFROM (SELECT 1) dummy\nLEFT JOIN gkr_users u ON (u.no_hp = '{{ $json.no_hp }}' OR u.waha_chat_id = '{{ $json.chatId }}')\nORDER BY u.id_user DESC\nLIMIT 1;",
