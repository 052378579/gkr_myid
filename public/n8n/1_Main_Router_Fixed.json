    {
      "parameters": {
        "jsCode": "let data = $input.all()[0].json;\nlet body = data.body || {};\nlet payload = body.payload;\n\n// Deteksi sumber: WA atau Web\nlet source = payload ? 'wa' : 'web';\n\n// Proteksi WA\nif (source === 'wa') {\n    if (payload.fromMe === true) return [];\n    if (payload.from === 'status@broadcast' || payload.from.includes('@broadcast')) return [];\n}\n\nlet chatId = source === 'wa' ? payload.from : (body.chatId || \"\");\nlet text = source === 'wa' ? (payload.body || \"\") : (body.text || \"\");\nlet msg_type = source === 'wa' ? (payload.type || \"text\") : (body.msg_type || \"text\");\nlet no_hp = source === 'wa' ? \"\" : (body.no_hp || \"\");\nlet messageId = source === 'wa' ? payload.id : \"\";\n\n// Parsing Nomor WA ke format 08xx\nif (source === 'wa') {\n    let rawNumber = chatId.split('@')[0];\n    let altJid = payload._data?.key?.remoteJidAlt;\n    if (chatId.includes('@lid') && altJid) rawNumber = altJid.split('@')[0];\n    if (rawNumber.startsWith('62')) {\n        no_hp = '0' + rawNumber.substring(2);\n    } else {\n        no_hp = rawNumber;\n    }\n}\n\n// Cek Media\nlet isImage = false;\nlet isVideo = false;\nif (source === 'wa') {\n    if (msg_type === 'image' || msg_type === 'imageMessage') isImage = true;\n    if (payload.hasMedia === true && (!payload.mimetype || payload.mimetype.includes('image'))) isImage = true;\n    if (payload.message?.imageMessage) isImage = true;\n    if (msg_type === 'video' || payload.mimetype?.includes('video')) isVideo = true;\n} else {\n    if (msg_type === 'image') isImage = true;\n    if (msg_type === 'video') isVideo = true;\n}\n\nlet intent = \"chat\";\nlet tipe_balasan = \"teks\";\nlet keyword = \"\";\nlet keyword_2 = \"\";\n\nif (isImage) {\n    msg_type = \"image\";\n    intent = \"image\";\n} else if (isVideo) {\n    msg_type = \"video\";\n    intent = \"video\";\n} else {\n    let upperText = text.toUpperCase().trim();\n    let erpMatches = upperText.match(/(FG-[A-Z0-9]+)/gi);\n    \n    if (erpMatches && erpMatches.length > 0) {\n        intent = \"erp\";\n        keyword = erpMatches[0].toUpperCase();\n        if (erpMatches.length > 1) keyword_2 = erpMatches[1].toUpperCase();\n    } else if (/^[1-9]$/.test(upperText)) {\n        intent = \"katalog_pilihan\";\n        tipe_balasan = \"detail\";\n        keyword = upperText;\n    } else if (upperText === 'MENU') {\n        intent = \"katalog\";\n        tipe_balasan = \"menu\";\n        keyword = \"\";\n    } else if (upperText.startsWith('CARI ') || upperText.startsWith('CARIKAN ')) {\n        intent = \"katalog\";\n        tipe_balasan = \"teks\";\n        keyword = text.substring(upperText.startsWith('CARIKAN ') ? 8 : 5).trim();\n    } else if (upperText.startsWith('FOTO ') || upperText.startsWith('GAMBAR ')) {\n        intent = \"katalog\";\n        tipe_balasan = \"gambar\";\n        keyword = text.substring(upperText.startsWith('GAMBAR ') ? 7 : 5).trim();\n    }\n}\n\nreturn [{ json: { source, chatId, no_hp, text, msg_type, intent, tipe_balasan, keyword, keyword_2, messageId } }];"
      },
