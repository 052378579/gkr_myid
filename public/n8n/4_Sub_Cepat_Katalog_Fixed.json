    {
      "parameters": {
        "jsCode": "let inputData = $items(\"Mulai\")[0].json;\nlet choice = parseInt(inputData.keyword) - 1; \nlet lastSearchIds = [];\ntry { lastSearchIds = JSON.parse(inputData.last_search_ids || \"[]\"); } catch(e) {}\nlet targetId = lastSearchIds[choice];\nif (!targetId) {\n    return [{ json: Object.assign({}, inputData, { targetId: null, output_text: \"Maaf, pilihan nomor tidak tersedia. Silakan ketik angka yang sesuai dengan daftar di atas.\", media_url: \"\" }) }];\n}\nreturn [{ json: Object.assign({}, inputData, { targetId: targetId }) }];"
