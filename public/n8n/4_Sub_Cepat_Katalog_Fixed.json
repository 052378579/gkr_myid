    {
      "parameters": {
        "jsCode": "let inputData = $items(\"Mulai\")[0].json;\nlet dbData = $input.all();\nlet output_text = \"\";\nlet searchIds = [];\n\nif (dbData.length > 0 && dbData[0].json && Object.keys(dbData[0].json).length > 0) {\n    output_text = \"Hasil Pencarian *_\\'\" + inputData.keyword + \"\\'_*. Ditemukan \" + dbData.length + \" Produk:\\n\";\n    \n    dbData.forEach((row, index) => {\n        searchIds.push(row.json.id);\n        output_text += (index + 1) + \". \" + (row.json.judul || \"Barang\") + \"\\n\";\n        output_text += \"Kode BOM: \" + (row.json.kode_bom || \"-\") + \"\\n\";\n    });\n    output_text += \"\\nBalas dengan ketik nomor pilihan\\n> Contoh: 1 atau 2\";\n} else {\n    output_text = \"Maaf, barang dengan kata kunci '\" + inputData.keyword + \"' tidak ditemukan di katalog kami.\";\n}\n\nreturn [{ json: Object.assign({}, inputData, { output_text: output_text, media_url: \"\", searchIds: searchIds }) }];"
      },
