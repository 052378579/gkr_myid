    {
      "parameters": {
        "jsCode": "let inputData = $items(\"Ekstrak Pilihan\")[0].json;\nlet dbData = $input.all();\nlet item = dbData[0].json;\nconst baseUrl = \"https://foto.budi.biz.id/\";\nconst shortUrlBase = \"https://gkr.my.id/go/\";\nlet tipe_history = inputData.status_interaksi || \"\";\nlet output_text = \"\";\nlet media_url = item.imageUrl ? (baseUrl + item.imageUrl) : \"\";\nif (tipe_history.includes(\"gambar\")) {\n    if (!item.imageUrl) {\n        output_text = \"Maaf, Foto \" + (item.judul || \"Barang\") + \" tidak ditemukan.\";\n    } else {\n        output_text = \"*\" + (item.judul || \"Barang\") + \"*\";\n        if (item.kode_bom && item.kode_bom.trim() !== \"\" && item.kode_bom !== \"-\") {\n            output_text += \"\\nKode BOM: \" + item.kode_bom + \"\\n\" + shortUrlBase + encodeURIComponent(item.kode_bom.trim());\n        }\n    }\n} else {\n    output_text = \"📦 *Detail Produk*\\n\\n\";\n    output_text += \"Nama: \" + item.judul + \"\\n\";\n    if (item.kode_bom && item.kode_bom.trim() !== \"\" && item.kode_bom !== \"-\") {\n        output_text += \"Kode BOM: \" + item.kode_bom + \"\\n\" + shortUrlBase + encodeURIComponent(item.kode_bom.trim()) + \"\\n\";\n    } else {\n        output_text += \"Kode BOM: -\\n\";\n    }\n    if (item.deskripsi) output_text += \"Deskripsi: \" + item.deskripsi + \"\\n\";\n}\nreturn [{ json: Object.assign({}, inputData, { output_text: output_text, media_url: media_url }) }];"
      },
