        "query": "UPDATE gkr_users SET status_interaksi = CONCAT('menunggu_pilihan_ussd_', '{{ $json.tipe_balasan }}'), last_search_ids = '{{ JSON.stringify($json.searchIds) }}', sesi_terakhir_update = NOW() WHERE waha_chat_id = '{{ $json.chatId }}' OR no_hp = '{{ $json.no_hp }}';",
