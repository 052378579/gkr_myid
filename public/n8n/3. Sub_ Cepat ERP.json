        "jsCode": "let inputData = $items(\"Mulai\")[0].json;\nlet dbData = $input.all();\nlet output_text = \"\";\n\nif (dbData.length > 0 && dbData[0].json && Object.keys(dbData[0].json).length > 0) {\n    let row = dbData[0].json;\n    output_text = \"Data ERP Ditemukan\\n\\n\";\n    output_text += \"Kode BOM: \" + (row.item_code || inputData.keyword) + \"\\n\";\n    if (row.item_name || row.name) output_text += \"Nama Barang: \" + (row.item_name || row.name) + \"\\n\";\n    if (row.dimension) output_text += \"Dimensi: \" + row.dimension + \"\\n\";\n    if (row.material) output_text += \"Material: \" + row.material + \"\\n\";\n    if (row.price) output_text += \"Harga: \" + row.price + \"\\n\";\n} else {\n    output_text = \"Maaf, data ERP untuk kode \" + inputData.keyword + \" tidak ditemukan di dalam sistem.\";\n}\n\nreturn [{ json: Object.assign({}, inputData, { output_text: output_text }) }];"
      },
